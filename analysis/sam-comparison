# ========= 2.1 Imports, seeding, device =========
import os, copy, math, random, time
from dataclasses import dataclass
from typing import Tuple, Dict, Any, List

import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
from tqdm.auto import tqdm

# Reproducibility
def set_seed(seed=123):
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.use_deterministic_algorithms(False)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# ========= 2.2 Model & data =========
class SmallCNN(nn.Module):
    def __init__(self, num_classes=10):
        super().__init__()
        self.conv1 = nn.Conv2d(1, 32, 3, padding=1)
        self.conv2 = nn.Conv2d(32, 64, 3, padding=1)
        self.pool  = nn.MaxPool2d(2, 2)
        self.fc1   = nn.Linear(64 * 7 * 7, 128)
        self.fc2   = nn.Linear(128, num_classes)

    def forward(self, x):
        x = self.pool(F.relu(self.conv1(x)))   # 28->14
        x = self.pool(F.relu(self.conv2(x)))   # 14->7
        x = x.view(x.size(0), -1)
        x = F.relu(self.fc1(x))
        return self.fc2(x)

def get_fashion_mnist(batch_size=128):
    transform = transforms.Compose([transforms.ToTensor()])
    train_ds = datasets.FashionMNIST(root="./data", train=True,  download=True, transform=transform)
    test_ds  = datasets.FashionMNIST(root="./data", train=False, download=True, transform=transform)
    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True,  num_workers=0, drop_last=True)
    test_loader  = DataLoader(test_ds,  batch_size=512,     shuffle=False, num_workers=0)
    return train_ds, test_ds, train_loader, test_loader

# ========= 2.3 Basic train/eval loops =========
def evaluate_model(model, loader, loss_fn, device=device):
    model.eval()
    total_loss, total_correct, total = 0.0, 0, 0
    with torch.no_grad():
        for xb, yb in loader:
            xb, yb = xb.to(device), yb.to(device)
            logits = model(xb)
            loss = loss_fn(logits, yb)
            total_loss += loss.item() * xb.size(0)
            total_correct += (logits.argmax(dim=1) == yb).sum().item()
            total += xb.size(0)
    return dict(loss=total_loss/total, acc=total_correct/total)

def train_epoch_sgd(model, loader, loss_fn, optimizer, device=device):
    model.train()
    total_loss, total_correct, total = 0.0, 0, 0
    for xb, yb in loader:
        xb, yb = xb.to(device), yb.to(device)
        optimizer.zero_grad(set_to_none=True)
        logits = model(xb)
        loss = loss_fn(logits, yb)
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * xb.size(0)
        total_correct += (logits.argmax(dim=1) == yb).sum().item()
        total += xb.size(0)
    return dict(loss=total_loss/total, acc=total_correct/total)

# ========= 2.4 SAM implementation =========
class SAM(torch.optim.Optimizer):
    """
    Minimal SAM (Foret et al., 2021).
    - base_optimizer: torch.optim.SGD or AdamW, constructed on same params
    - rho: radius (L2)
    - adaptive: switch to ASAM (scale by |w|)
    """
    def __init__(self, params, base_optimizer, rho=0.05, adaptive=False, **kwargs):
        if rho <= 0:
            raise ValueError("rho must be > 0")
        self.rho = rho
        self.adaptive = adaptive
        defaults = dict(rho=rho, adaptive=adaptive, **kwargs)
        super().__init__(params, defaults)
        self.base_optimizer = base_optimizer(self.param_groups, **kwargs)

    @torch.no_grad()
    def _grad_norm(self):
        # ||g|| or |||w| ⊙ g|| for ASAM
        shared_device = self.param_groups[0]['params'][0].device
        norm = torch.zeros(1, device=shared_device)
        for group in self.param_groups:
            for p in group['params']:
                if p.grad is None:
                    continue
                if self.adaptive:
                    e = torch.abs(p) * p.grad
                else:
                    e = p.grad
                norm += torch.sum(e * e)
        return norm.sqrt()

    @torch.no_grad()
    def first_step(self, zero_grad=True):
        norm = self._grad_norm()
        scale = self.rho / (norm + 1e-12)
        for group in self.param_groups:
            for p in group['params']:
                if p.grad is None:
                    continue
                e = torch.abs(p) * p.grad if self.adaptive else p.grad
                p.add_(e, alpha=scale)  # w <- w + eps
                self.state[p]['eps'] = e * scale
        if zero_grad:
            self.zero_grad()

    @torch.no_grad()
    def second_step(self, zero_grad=True):
        for group in self.param_groups:
            for p in group['params']:
                if 'eps' in self.state[p]:
                    p.sub_(self.state[p]['eps'])  # w <- w - eps
        self.base_optimizer.step()
        if zero_grad:
            self.zero_grad()

    def step(self):
        # not used; call first_step, then compute grad at perturbed weights, then second_step
        raise NotImplementedError("Call first_step/second_step explicitly.")

def train_epoch_sam(model, loader, loss_fn, sam_optim: SAM, device=device):
    model.train()
    total_loss, total_correct, total = 0.0, 0, 0
    for xb, yb in loader:
        xb, yb = xb.to(device), yb.to(device)

        # 1) grad at current weights
        logits = model(xb); loss = loss_fn(logits, yb)
        loss.backward()
        sam_optim.first_step(zero_grad=True)

        # 2) grad at perturbed weights (worst-case direction)
        logits_ = model(xb); loss_ = loss_fn(logits_, yb)
        loss_.backward()
        sam_optim.second_step(zero_grad=True)

        total_loss += loss.item() * xb.size(0)
        total_correct += (logits.argmax(dim=1) == yb).sum().item()
        total += xb.size(0)
    return dict(loss=total_loss/total, acc=total_correct/total)

# ========= 2.5 Top-level training run =========
@dataclass
class TrainCfg:
    epochs: int = 4
    batch_size: int = 128
    base_lr: float = 0.05
    momentum: float = 0.9
    weight_decay: float = 5e-4
    sam_rho: float = 0.05
    sam_adaptive: bool = False
    seed: int = 123

def run_train(cfg: TrainCfg, use_sam: bool) -> Dict[str, Any]:
    set_seed(cfg.seed)
    train_ds, test_ds, train_loader, test_loader = get_fashion_mnist(cfg.batch_size)
    model = SmallCNN().to(device)
    loss_fn = nn.CrossEntropyLoss()

    if use_sam:
        base = torch.optim.SGD
        optimizer = SAM(model.parameters(), base_optimizer=base,
                        lr=cfg.base_lr, momentum=cfg.momentum,
                        weight_decay=cfg.weight_decay, rho=cfg.sam_rho,
                        adaptive=cfg.sam_adaptive)
        train_epoch = lambda: train_epoch_sam(model, train_loader, loss_fn, optimizer)
    else:
        optimizer = torch.optim.SGD(model.parameters(), lr=cfg.base_lr,
                                    momentum=cfg.momentum, weight_decay=cfg.weight_decay)
        train_epoch = lambda: train_epoch_sgd(model, train_loader, loss_fn, optimizer)

    history = []
    for epoch in range(cfg.epochs):
        train_stats = train_epoch()
        test_stats  = evaluate_model(model, test_loader, loss_fn)
        history.append(dict(epoch=epoch, **train_stats, **{f"test_{k}": v for k,v in test_stats.items()}))
        print(f"[{('SAM' if use_sam else 'SGD')}] Epoch {epoch}: "
              f"train loss {train_stats['loss']:.3f}, acc {train_stats['acc']:.3f} | "
              f"test loss {test_stats['loss']:.3f}, acc {test_stats['acc']:.3f}")

    return dict(model=model, loss_fn=loss_fn, train_loader=train_loader,
                test_loader=test_loader, history=history, train_ds=train_ds)
